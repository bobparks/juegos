<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nidia en el Laberinto</title>
<style>
  html,body{margin:0;background:#2a0a20;color:#ffe3f1;font-family:system-ui,sans-serif;display:flex;flex-direction:column;align-items:center;min-height:100vh}
  h1{font-size:22px;margin:12px 0 4px;letter-spacing:1px}
  #hud{display:flex;gap:24px;font-size:16px;margin:4px 0 8px}
  canvas{background:#1a0614;border:3px solid #ff6fb5;border-radius:8px;max-width:calc(100vw - 32px);height:auto;touch-action:none}
  #pad{display:grid;grid-template-columns:repeat(3,56px);gap:6px;margin:12px}
  #pad button{height:56px;font-size:22px;border-radius:10px;border:none;background:#c2407f;color:#fff}
  #pad button:active{background:#ff6fb5}
  p{font-size:13px;opacity:.75;margin:4px 16px;text-align:center}
</style>
</head>
<body>
<h1>🌮 Nidia en el Laberinto</h1>
<div id="hud"><span>Puntos: <b id="score">0</b></span><span>Vidas: <b id="lives">3</b></span><span>Nivel: <b id="level">1</b></span></div>
<canvas id="c"></canvas>
<div id="pad">
  <span></span><button data-d="up">▲</button><span></span>
  <button data-d="left">◀</button><button data-d="start">●</button><button data-d="right">▶</button>
  <span></span><button data-d="down">▼</button><span></span>
</div>
<p>Flechas o WASD para moverte · Espacio / Enter para empezar o pausar · Los tacos asustan a los cangrejos</p>
<script>
const MAP = [
"###################",
"#........#........#",
"#o##.###.#.###.##o#",
"#.................#",
"#.##.#.#####.#.##.#",
"#....#...#...#....#",
"####.### # ###.####",
"   #.#       #.#   ",
"####.# ##-## #.####",
"    .  #   #  .    ",
"####.# ##### #.####",
"   #.#       #.#   ",
"####.# ##### #.####",
"#........#........#",
"#.##.###.#.###.##.#",
"#o.#.....P.....#.o#",
"##.#.#.#####.#.#.##",
"#....#...#...#....#",
"#.######.#.######.#",
"#.................#",
"###################"];
const ROWS = MAP.length, COLS = MAP[0].length, T = 28;
const cv = document.getElementById('c'), ctx = cv.getContext('2d');
cv.width = COLS*T; cv.height = ROWS*T + 0;

const DIRS = {up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};
const OPP = {up:'down',down:'up',left:'right',right:'left'};
let grid, bottles, score=0, lives=3, level=1, state='ready', frightT=0, combo=0, msgT=0, player, ghosts, startPos;

function cell(c,r){ c=((c%COLS)+COLS)%COLS; if(r<0||r>=ROWS) return '#'; return grid[r][c]; }
function walk(c,r,isGhost){ const ch=cell(c,r); if(ch==='#') return false; if(ch==='-') return !!isGhost; return true; }

function buildLevel(){
  grid = MAP.map(r=>r.split('')); bottles=0;
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(grid[r][c]==='P'){startPos=[c,r];grid[r][c]=' ';}
    if(grid[r][c]==='.'||grid[r][c]==='o') bottles++;
  }
}
function resetActors(){
  player={x:startPos[0],y:startPos[1],dir:'left',next:'left',speed:6+level*0.3,mouth:0,moving:true};
  const colors=['#e8452c','#f28c28','#9b5cff','#b0e03a'];
  ghosts=[[9,7],[8,9],[9,9],[10,9]].map((p,i)=>({x:p[0],y:p[1],dir:'left',color:colors[i],i,
    home:[p[0],p[1]],release:i*3,out:i===0,eaten:false,speed:4.6+level*0.35}));
  frightT=0;
}
function newGame(){score=0;lives=3;level=1;buildLevel();resetActors();state='ready';updHud();}

function updHud(){ score_el.textContent=score; lives_el.textContent=lives; level_el.textContent=level; }
const score_el=document.getElementById('score'),lives_el=document.getElementById('lives'),level_el=document.getElementById('level');

// ---- movement ----
function stepEntity(e,dt,chooser,isGhost){
  let step=e.speed*dt;
  let guard=0;
  while(step>0 && guard++<10){
    if(!e.dir){ chooser(e); if(!e.dir) return; }
    const [dx,dy]=DIRS[e.dir];
    const tx=Math.round(e.x)+(isCentered(e)?dx:0), ty=Math.round(e.y)+(isCentered(e)?dy:0);
    // distance to next centre along dir
    let dist = dx? Math.abs((dx>0?Math.floor(e.x+1e-6)+1:Math.ceil(e.x-1e-6)-1)-e.x) : Math.abs((dy>0?Math.floor(e.y+1e-6)+1:Math.ceil(e.y-1e-6)-1)-e.y);
    if(isCentered(e)){
      chooser(e);
      if(!e.dir) return;
      const [ddx,ddy]=DIRS[e.dir];
      if(!walk(Math.round(e.x)+ddx,Math.round(e.y)+ddy,isGhost)){ e.moving=false; return; }
      dist=1;
    }
    const [mx,my]=DIRS[e.dir];
    if(step>=dist-1e-6){ e.x=Math.round(e.x+mx*dist); e.y=Math.round(e.y+my*dist); step-=dist; wrap(e); onCenter(e); }
    else { e.x+=mx*step; e.y+=my*step; step=0; }
    e.moving=true;
  }
}
function isCentered(e){ return Math.abs(e.x-Math.round(e.x))<1e-4 && Math.abs(e.y-Math.round(e.y))<1e-4; }
function wrap(e){ if(e.x<0) e.x+=COLS; if(e.x>=COLS) e.x-=COLS; }
function onCenter(e){ if(e===player) eat(); }

function playerChooser(e){
  const c=Math.round(e.x), r=Math.round(e.y);
  if(e.next && walk(c+DIRS[e.next][0], r+DIRS[e.next][1])) e.dir=e.next;
  else if(!walk(c+DIRS[e.dir][0], r+DIRS[e.dir][1])) { e.moving=false; e.dir=e.dir; }
}
function ghostTarget(g){
  if(g.eaten) return [9,7];
  if(!g.out) return [9,7];
  const p=[Math.round(player.x),Math.round(player.y)], pd=DIRS[player.dir];
  switch(g.i){
    case 0: return p;
    case 1: return [p[0]+pd[0]*4,p[1]+pd[1]*4];
    case 2: return [p[0]-pd[0]*2+ (Math.round(ghosts[0].x)-p[0])*-1, p[1]-pd[1]*2+(Math.round(ghosts[0].y)-p[1])*-1];
    default: return Math.hypot(g.x-p[0],g.y-p[1])>8 ? p : [0,ROWS];
  }
}
function ghostChooser(g){
  const c=Math.round(g.x), r=Math.round(g.y);
  if(g.eaten && c===9 && r===7){ g.eaten=false; g.speed=4.6+level*0.35; }
  if(!g.out && c===9 && r===7) g.out=true;
  const opts=Object.keys(DIRS).filter(d=>{
    if(d===OPP[g.dir] && g.dir) return false;
    const [dx,dy]=DIRS[d]; const nc=c+dx,nr=r+dy;
    if(cell(nc,nr)==='-' && g.out && !g.eaten) return false;
    return walk(nc,nr,true);
  });
  if(!opts.length){ g.dir=OPP[g.dir]; return; }
  if(frightT>0 && !g.eaten && g.out){ g.dir=opts[Math.floor(Math.random()*opts.length)]; return; }
  const [tx,ty]=ghostTarget(g);
  opts.sort((a,b)=>{
    const da=Math.hypot(c+DIRS[a][0]-tx,r+DIRS[a][1]-ty), db=Math.hypot(c+DIRS[b][0]-tx,r+DIRS[b][1]-ty);
    return da-db;
  });
  g.dir=opts[0];
}

function eat(){
  const c=Math.round(player.x), r=Math.round(player.y), ch=cell(c,r);
  if(ch==='.'){ grid[r][c]=' '; score+=10; bottles--; }
  else if(ch==='o'){ grid[r][c]=' '; score+=50; bottles--; frightT=Math.max(3,8-level*0.6); combo=0;
    ghosts.forEach(g=>{ if(g.out&&!g.eaten) g.dir=OPP[g.dir]; }); }
  updHud();
  if(bottles<=0){ level++; buildLevel(); resetActors(); state='ready'; msgT=0; updHud(); }
}

let elapsed=0;
function update(dt){
  if(state!=='play') return;
  elapsed+=dt;
  if(frightT>0) frightT-=dt;
  player.mouth+=dt*12;
  stepEntity(player,dt,playerChooser,false);
  ghosts.forEach(g=>{
    if(!g.out && elapsed<g.release) return;
    const sp=g.speed; if(g.eaten) g.speed=12; else if(frightT>0) g.speed=sp*0.55;
    stepEntity(g,dt,ghostChooser,true);
    g.speed = g.eaten?12:(4.6+level*0.35);
    // collision
    let dx=Math.abs(g.x-player.x); dx=Math.min(dx,COLS-dx);
    if(!g.eaten && dx<0.6 && Math.abs(g.y-player.y)<0.6){
      if(frightT>0 && g.out){ g.eaten=true; combo++; score+=200*Math.pow(2,combo-1); updHud(); }
      else die();
    }
  });
}
function die(){
  lives--; updHud();
  if(lives<=0){ state='over'; }
  else { resetActors(); elapsed=0; state='ready'; }
}

// ---- drawing ----
function drawWalls(){
  ctx.fillStyle='#1a0614'; ctx.fillRect(0,0,cv.width,cv.height);
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    const ch=grid[r][c], x=c*T, y=r*T;
    if(ch==='#'){
      ctx.fillStyle='#6b1a4f'; ctx.fillRect(x,y,T,T);
      ctx.strokeStyle='#ff8cc6'; ctx.lineWidth=2;
      if(cell(c,r-1)!=='#'){ctx.beginPath();ctx.moveTo(x,y+1);ctx.lineTo(x+T,y+1);ctx.stroke();}
      if(cell(c,r+1)!=='#'){ctx.beginPath();ctx.moveTo(x,y+T-1);ctx.lineTo(x+T,y+T-1);ctx.stroke();}
      if(c>0&&cell(c-1,r)!=='#'){ctx.beginPath();ctx.moveTo(x+1,y);ctx.lineTo(x+1,y+T);ctx.stroke();}
      if(c<COLS-1&&cell(c+1,r)!=='#'){ctx.beginPath();ctx.moveTo(x+T-1,y);ctx.lineTo(x+T-1,y+T);ctx.stroke();}
    } else if(ch==='-'){ ctx.fillStyle='#ffd1e8'; ctx.fillRect(x,y+T/2-2,T,4); }
    else if(ch==='.') drawBottle(x+T/2,y+T/2,0.55);
    else if(ch==='o') drawTaco(x+T/2,y+T/2);
  }
}
function drawBottle(cx,cy,s){
  ctx.save(); ctx.translate(cx,cy); ctx.scale(s,s);
  ctx.fillStyle='#8a4b16'; ctx.beginPath(); ctx.roundRect(-6,-4,12,16,3); ctx.fill();
  ctx.fillRect(-2.5,-12,5,9);
  ctx.fillStyle='#d8b27a'; ctx.fillRect(-2.5,-15,5,4);
  ctx.fillStyle='#f4e2b0'; ctx.fillRect(-5,1,10,6);
  ctx.fillStyle='rgba(255,255,255,.35)'; ctx.fillRect(-4,-3,2,9);
  ctx.restore();
}
function drawTaco(cx,cy){
  const p=1+Math.sin(performance.now()/180)*0.08;
  ctx.save(); ctx.translate(cx,cy+4); ctx.scale(p,p);
  // lettuce, meat and tomato peeking out of the top
  ctx.fillStyle='#4caf2e'; ctx.beginPath(); ctx.arc(0,0,11,Math.PI,2*Math.PI); ctx.fill();
  ctx.fillStyle='#8a4a22'; ctx.beginPath(); ctx.arc(0,1,9,Math.PI,2*Math.PI); ctx.fill();
  ctx.fillStyle='#e0332d'; [[-6,-5],[0,-8],[6,-5]].forEach(([x,y])=>{ctx.beginPath();ctx.arc(x,y,2.2,0,Math.PI*2);ctx.fill();});
  // folded tortilla
  ctx.fillStyle='#f7c948'; ctx.strokeStyle='#c98f1c'; ctx.lineWidth=1.2;
  ctx.beginPath(); ctx.arc(0,-3,12,0.12*Math.PI,0.88*Math.PI); ctx.closePath(); ctx.fill(); ctx.stroke();
  ctx.fillStyle='rgba(170,110,20,.55)'; [[-5,3],[1,6],[6,2]].forEach(([x,y])=>{ctx.beginPath();ctx.arc(x,y,1.1,0,Math.PI*2);ctx.fill();});
  ctx.restore();
}
const FACE=new Image(); FACE.src='data:image/png;base64,';
function drawPlayer(){
  const x=player.x*T+T/2, y=player.y*T+T/2;
  const R=T*0.52*(player.moving?1+Math.abs(Math.sin(player.mouth))*0.08:1);
  const tilt={left:-0.12,right:0.12,up:0,down:0}[player.dir]||0;
  ctx.save(); ctx.translate(x,y); ctx.rotate(tilt);
  ctx.fillStyle='#ff6fb5'; ctx.beginPath(); ctx.arc(0,0,R+2.5,0,Math.PI*2); ctx.fill();
  ctx.save(); ctx.beginPath(); ctx.arc(0,0,R,0,Math.PI*2); ctx.clip();
  if(FACE.complete) ctx.drawImage(FACE,-R,-R,R*2,R*2);
  ctx.restore(); ctx.restore();
}
function drawCrab(g){
  if(!g.out && elapsed<g.release && state==='play'){}
  const x=g.x*T+T/2, y=g.y*T+T/2, t=performance.now()/120;
  ctx.save(); ctx.translate(x,y);
  if(!g.eaten){
    const scared=frightT>0 && g.out;
    const blink=scared && frightT<2 && Math.floor(t)%2===0;
    const col=scared?(blink?'#eee':'#2d5bff'):g.color;
    ctx.strokeStyle=col; ctx.lineWidth=2;
    for(let s=-1;s<=1;s+=2) for(let k=0;k<3;k++){ ctx.beginPath(); ctx.moveTo(s*6,2+k*2); ctx.lineTo(s*12,6+k*3+Math.sin(t+k)*1.5); ctx.stroke(); }
    ctx.fillStyle=col;
    for(let s=-1;s<=1;s+=2){ ctx.beginPath(); ctx.arc(s*11,-6+Math.sin(t)*1.5,4,0,Math.PI*2); ctx.fill(); }
    ctx.beginPath(); ctx.ellipse(0,1,10,7.5,0,0,Math.PI*2); ctx.fill();
  }
  // eyes on stalks
  ctx.strokeStyle='#ddd'; ctx.lineWidth=1.5;
  for(let s=-1;s<=1;s+=2){ ctx.beginPath(); ctx.moveTo(s*3,-4); ctx.lineTo(s*4,-10); ctx.stroke();
    ctx.fillStyle='#fff'; ctx.beginPath(); ctx.arc(s*4,-11,3,0,Math.PI*2); ctx.fill();
    const [dx,dy]=DIRS[g.dir||'left']; ctx.fillStyle='#111'; ctx.beginPath(); ctx.arc(s*4+dx*1.3,-11+dy*1.3,1.4,0,Math.PI*2); ctx.fill(); }
  ctx.restore();
}
function banner(text,sub){
  ctx.fillStyle='rgba(40,0,25,.75)'; ctx.fillRect(0,cv.height/2-50,cv.width,100);
  ctx.fillStyle='#ff8cc6'; ctx.font='bold 28px system-ui'; ctx.textAlign='center'; ctx.fillText(text,cv.width/2,cv.height/2-5);
  if(sub){ ctx.fillStyle='#ffe3f1'; ctx.font='15px system-ui'; ctx.fillText(sub,cv.width/2,cv.height/2+25); }
}
function draw(){
  drawWalls(); ghosts.forEach(drawCrab); drawPlayer();
  if(state==='ready') banner(level===1&&score===0?'¡A por el ron!':'Nivel '+level,'Pulsa Espacio, ● o una flecha para empezar');
  if(state==='pause') banner('Pausa','Espacio para continuar');
  if(state==='over') banner('¡Fin del juego!','Puntos: '+score+' · Espacio para jugar de nuevo');
}

// ---- input ----
function setDir(d){
  if(state==='ready'){ state='play'; }
  else if(state==='over'){ newGame(); state='play'; }
  player.next=d;
  if(d===OPP[player.dir]) player.dir=d;
}
function toggle(){
  if(state==='play') state='pause';
  else if(state==='over'){ newGame(); state='play'; }
  else state='play';
}
const KEYS={ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',w:'up',s:'down',a:'left',d:'right',W:'up',S:'down',A:'left',D:'right'};
addEventListener('keydown',e=>{
  if(KEYS[e.key]){ setDir(KEYS[e.key]); e.preventDefault(); }
  else if(e.key===' '||e.key==='Enter'){ toggle(); e.preventDefault(); }
});
document.querySelectorAll('#pad button').forEach(b=>b.addEventListener('pointerdown',e=>{
  e.preventDefault(); const d=b.dataset.d; d==='start'?toggle():setDir(d);
}));
let sx,sy;
cv.addEventListener('touchstart',e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY;},{passive:true});
cv.addEventListener('touchend',e=>{
  const dx=e.changedTouches[0].clientX-sx, dy=e.changedTouches[0].clientY-sy;
  if(Math.max(Math.abs(dx),Math.abs(dy))<20){ toggle(); return; }
  setDir(Math.abs(dx)>Math.abs(dy)?(dx>0?'right':'left'):(dy>0?'down':'up'));
});

// ---- loop ----
let last=performance.now();
function loop(now){
  const dt=Math.min(0.05,(now-last)/1000); last=now;
  update(dt); draw(); requestAnimationFrame(loop);
}
newGame(); requestAnimationFrame(loop);
</script>
</body>
